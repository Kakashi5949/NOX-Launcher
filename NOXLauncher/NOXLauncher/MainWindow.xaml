<Window x:Class="NOXLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NØX Launcher"
        Height="560" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#090909"
        Foreground="White"
        FontFamily="Segoe UI">

    <Grid Margin="35">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="NØX"
                       FontSize="44"
                       FontWeight="Bold"/>
            <TextBlock Text="BE DIFFERENT. PLAY SMART."
                       FontSize="11"
                       Foreground="#999999"/>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Width="390"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">

            <TextBlock Text="ИГРОВОЙ НИК"
                       Foreground="#AAAAAA"
                       Margin="0,0,0,10"/>

            <TextBox x:Name="NicknameBox"
                     Text="Skeatxbx"
                     Height="45"
                     FontSize="16"
                     Padding="12"
                     Background="#171717"
                     Foreground="White"
                     BorderBrush="#444444"/>

            <TextBlock Text="ВЕРСИЯ ИГРЫ"
                       Foreground="#AAAAAA"
                       Margin="0,24,0,10"/>

            <Border Background="#171717"
                    BorderBrush="#444444"
                    BorderThickness="1"
                    Padding="14">
                <TextBlock Text="Minecraft Java 1.21.11 • Fabric"
                           FontSize="14"/>
            </Border>

            <Button Content="PLAY"
                    Height="55"
                    Margin="0,30,0,0"
                    Background="White"
                    Foreground="Black"
                    FontSize="17"
                    FontWeight="Bold"
                    BorderThickness="0"/>
        </StackPanel>

        <TextBlock Grid.Row="2"
                   Text="NØX LAUNCHER • EARLY BUILD"
                   Foreground="#666666"
                   FontSize="10"/>
    </Grid>
</Window>
